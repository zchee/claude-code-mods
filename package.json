{
  "name": "claude-code-mods",
  "version": "0.1.0",
  "private": true,
  "description": "Opinionated Claude Code Mods plugins.",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "mods"
  ],
  "homepage": "https://github.com/zchee/claude-code-mods#readme",
  "bugs": {
    "url": "https://github.com/zchee/claude-code-mods/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zchee/claude-code-mods.git"
  },
  "license": "Apache-2.0",
  "author": "Koichi Shiraishi <zchee.io@gmail.com>",
  "type": "module",
  "scripts": {
    "check": "pnpm run validate && pnpm run typecheck && pnpm run test",
    "test": "bash scripts/each-mod.bash claude plugin test",
    "typecheck": "tsc -p mods",
    "types:sync": "bash scripts/sync-types.bash",
    "validate": "claude plugin validate --strict . && bash scripts/each-mod.bash claude plugin validate --strict"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
